{
  "title": "AutoHotkey MacBook Pro JIS",
  "rules": [
    {
      "description": "AutoHotkey: MacBook Pro JIS keymap",
      "manipulators": [
        {
          "type": "basic",
          "from": {"key_code": "caps_lock","modifiers": {"optional": ["any"]}},
          "to": [{"key_code": "right_command"}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]}],
          "description": "CapsLock を Right Command にする"
        },
        {
          "type": "basic",
          "from": {"key_code": "left_command","modifiers": {"optional": ["any"]}},
          "to": [{"set_variable": {"name": "autohotkey_jis_left_command_pressed","value": 1}},{"key_code": "left_option"}],
          "to_after_key_up": [{"set_variable": {"name": "autohotkey_jis_left_command_pressed","value": 0}}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]}],
          "description": "左CommandをOption出力のLAltレイヤーにする"
        },
        {
          "type": "basic",
          "from": {"key_code": "japanese_kana","modifiers": {"optional": ["any"]}},
          "to": [{"set_variable": {"name": "autohotkey_jis_kana_pressed","value": 1}},{"key_code": "left_shift"}],
          "to_after_key_up": [{"set_variable": {"name": "autohotkey_jis_kana_pressed","value": 0}}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]}],
          "description": "かなをShiftとして押下し、かなレイヤーを記録する"
        },
        {
          "type": "basic",
          "from": {"key_code": "spacebar","modifiers": {"mandatory": ["left_shift"]}},
          "to": [{"key_code": "japanese_eisuu"}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]},{"type": "variable_if","name": "autohotkey_jis_kana_pressed","value": 1}],
          "description": "かな+Spaceで英数入力に切り替える"
        },
        {
          "type": "basic",
          "from": {"key_code": "japanese_eisuu","modifiers": {"mandatory": ["left_shift"]}},
          "to": [{"key_code": "right_control"}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]},{"type": "variable_if","name": "autohotkey_jis_kana_pressed","value": 1}],
          "description": "かな押下中は英数を単押しでかな入力、保持時Right Controlにする",
          "to_if_alone": [{"key_code": "japanese_kana"}],
          "parameters": {"basic.to_if_alone_timeout_milliseconds": 200}
        },
        {
          "type": "basic",
          "from": {"key_code": "japanese_eisuu","modifiers": {"optional": ["any"]}},
          "to": [{"key_code": "right_control"}],
          "to_if_alone": [{"key_code": "japanese_eisuu"},{"key_code": "escape"}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]},{"type": "variable_unless","name": "autohotkey_jis_kana_pressed","value": 1}],
          "parameters": {"basic.to_if_alone_timeout_milliseconds": 200},
          "description": "英数を単押しで英数入力に切替えてEscape、保持時Right Controlにする"
        },
        {
          "type": "basic",
          "from": {"key_code": "left_control","modifiers": {"optional": ["any"]}},
          "to": [{"key_code": "left_control"}],
          "to_if_alone": [{"key_code": "tab"}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]}],
          "parameters": {"basic.to_if_alone_timeout_milliseconds": 200},
          "description": "左Controlを単押しTab、保持時Controlにする"
        },
        {
          "type": "basic",
          "from": {"key_code": "semicolon","modifiers": {"mandatory": ["left_shift"]}},
          "to": [{"key_code": "7","modifiers": ["left_shift"]}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]},{"type": "variable_if","name": "autohotkey_jis_kana_pressed","value": 1}],
          "description": "かな+; でアポストロフィを入力する"
        },
        {
          "type": "basic",
          "from": {"key_code": "quote","modifiers": {"mandatory": ["left_shift"]}},
          "to": [{"key_code": "2","modifiers": ["left_shift"]}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]},{"type": "variable_if","name": "autohotkey_jis_kana_pressed","value": 1}],
          "description": "かな+: でダブルクォートを入力する"
        },
        {
          "type": "basic",
          "from": {"key_code": "semicolon","modifiers": {"mandatory": ["left_shift","right_control"]}},
          "to": [{"key_code": "semicolon","modifiers": ["left_shift"]}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]},{"type": "variable_if","name": "autohotkey_jis_kana_pressed","value": 1}],
          "description": "かな+英数+; でプラスを入力する"
        },
        {
          "type": "basic",
          "from": {"key_code": "quote","modifiers": {"mandatory": ["left_shift","right_control"]}},
          "to": [{"key_code": "quote","modifiers": ["left_shift"]}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]},{"type": "variable_if","name": "autohotkey_jis_kana_pressed","value": 1}],
          "description": "かな+英数+: でアスタリスクを入力する"
        },
        {
          "type": "basic",
          "from": {"key_code": "u","modifiers": {"mandatory": ["right_control"]}},
          "to": [{"key_code": "left_arrow","modifiers": ["left_option"]}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]}],
          "description": "英数/RCtrl+u を割り当てる"
        },
        {
          "type": "basic",
          "from": {"key_code": "i","modifiers": {"mandatory": ["right_control"]}},
          "to": [{"key_code": "right_arrow","modifiers": ["left_option"]}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]}],
          "description": "英数/RCtrl+i を割り当てる"
        },
        {
          "type": "basic",
          "from": {"key_code": "a","modifiers": {"mandatory": ["right_control"]}},
          "to": [{"key_code": "a","modifiers": ["left_command"]}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]}],
          "description": "英数/RCtrl+a を割り当てる"
        },
        {
          "type": "basic",
          "from": {"key_code": "s","modifiers": {"mandatory": ["right_control"]}},
          "to": [{"key_code": "delete_or_backspace","modifiers": ["left_option"]}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]}],
          "description": "英数/RCtrl+s を割り当てる"
        },
        {
          "type": "basic",
          "from": {"key_code": "d","modifiers": {"mandatory": ["right_control"]}},
          "to": [{"key_code": "delete_or_backspace"}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]}],
          "description": "英数/RCtrl+d を割り当てる"
        },
        {
          "type": "basic",
          "from": {"key_code": "f","modifiers": {"mandatory": ["right_control"]}},
          "to": [{"key_code": "delete_forward"}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]}],
          "description": "英数/RCtrl+f を割り当てる"
        },
        {
          "type": "basic",
          "from": {"key_code": "h","modifiers": {"mandatory": ["right_control"]}},
          "to": [{"key_code": "left_arrow"}],
          "conditions": [{"type": "device_if","identifiers": [{"is_built_in_keyboard": true}]}],
          "description": "英数/RCtrl+h を割り当てる"
        },
        {
          "type": "basic",
